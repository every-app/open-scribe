{
  "entry": [
    "everyapp.config.ts",
    "cloudflare.config.ts",
    "src/entry.worker.ts",
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    // shadcn components are copied in whole; pages use only some exports
    "src/client/components/ui/**",
  ],
  "project": ["**/*.{ts,tsx}", "!src/routeTree.gen.ts"],
  "ignoreDependencies": [
    // `cloudflare:workers` is the runtime's module, not the `cloudflare` package.
    "cloudflare",
    // The SDK's required peer dependency.
    "jose",
    // Loaded by @tailwindcss/vite from src/styles/app.css.
    "tailwindcss",
    // Imported by app.css; shadcn is also the component CLI.
    "tw-animate-css",
    "shadcn",
    // Linked from an Every App checkout until the SDK is published: Knip
    // follows the source imports but doesn't credit them as package usage.
    "@every-app/sdk",
  ],
}
